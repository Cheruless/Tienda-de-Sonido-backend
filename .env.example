# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
# .env esta ignorado por git: NUNCA lo commitees.

# Debe ser identico en auth-service, catalog-service y cart-service (minimo 32 caracteres).
JWT_SECRET=cambia-este-secreto-por-uno-de-minimo-32-caracteres-seguro

# ---------- auth-service (PostgreSQL) ----------
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass

# ---------- catalog-service (MySQL) ----------
CATALOG_DB_NAME=tienda_catalogo
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_pass
MYSQL_ROOT_PASSWORD=root

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Cart -> catalog (ya configurado en el compose) ----------
# CATALOG_CLIENT=http
# CATALOG_BASE_URL=http://catalog-service:8082
