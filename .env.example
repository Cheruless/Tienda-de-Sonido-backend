# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
# .env esta ignorado por git: NUNCA lo commitees.

# Debe ser identico al JWT_SECRET de auth-service (minimo 32 caracteres).
JWT_SECRET=cambia-este-secreto-por-uno-de-minimo-32-caracteres-seguro

# Origenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# fake (desarrollo) | http (cuando exista catalog-service)
CATALOG_CLIENT=fake
